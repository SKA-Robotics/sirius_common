    <axis xyz="0 0 1"/>
  </joint>
  <joint name="gnss_joint" type="fixed">
    <parent link="platform"/>
    <child link="gnss"/>
    <origin rpy="0 0 0" xyz="-0.38 0 0.306"/>
    <axis xyz="0 0 1"/>
  </joint>
  <!-- Gazebo plugins -->
  <gazebo>
    <!-- hardware interfaces for wheels -->
    <plugin filename="libgazebo_ros_control.so" name="gazebo_ros_control">
      <robotNamespace>/</robotNamespace>
    </plugin>
    <!-- Ground truth pose for base_link -->
    <plugin filename="libsirius_gazebo_ros_p3d.so" name="p3d_plugin">
      <alwaysOn>true</alwaysOn>
      <updateRate>200.0</updateRate>
      <bodyName>base_link</bodyName>
      <topicName>ground_truth</topicName>
      <frameName>map</frameName>
      <frameXyzOffset>-9.396 16.082 0</frameXyzOffset>
      <frameRpyOffset>0 0 2.5204299728050112</frameRpyOffset>
    </plugin>
  </gazebo>
</robot>
